# 배포 도메인 (sitemap / robots / og 메타에 사용). 비우면 Vercel 값 → localhost 순으로 폴백합니다.
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 NEXT_PUBLIC_ 접두어를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 클릭 익명 해시용 솔트 (아무 랜덤 문자열)
CLICK_HASH_SALT=

# 수집 API 보호용 시크릿 (x-collect-secret 헤더로 전달)
COLLECT_SECRET=

# 관리자 페이지 비밀번호 (/admin). 비우면 관리자 페이지가 잠깁니다.
ADMIN_PASSWORD=

# (선택) 세션 서명 키. 비우면 ADMIN_PASSWORD 를 사용합니다.
ADMIN_SESSION_SECRET=
